DATABASE_URL=postgresql://postgres:postgres@localhost:5433/carancho
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
MERCADOPAGO_PUBLIC_BASE_URL=http://localhost:3000
# Optional
MERCADOPAGO_STATEMENT_DESCRIPTOR=CARANCHO
PAYLOAD_SECRET=change-me-local-secret
PAYLOAD_DISABLE_BLOB_STORAGE=true
# Cloudflare R2 (S3-compatible). Set PAYLOAD_DISABLE_BLOB_STORAGE=false once these are filled in.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# Optional. Admin WhatsApp alert for confirmed orders via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/).
# Obtain it by sending "I allow callmebot to send me messages" via WhatsApp to +34 684 783 347
# from the phone number stored as `phone` in the store contact. If that number ever changes,
# the key must be renewed the same way.
CALLMEBOT_API_KEY=
